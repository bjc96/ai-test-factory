{
  "name": "ai-test-factory",
  "version": "1.0.0",
  "description": "智能测试工场 - AI驱动的测试用例和自动化脚本生成工具",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 npx electron .",
    "dev:all": "concurrently --kill-others \"npm run dev\" \"npm run electron\"",
    "build": "vite build",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.ai-test-factory.app",
    "productName": "智能测试工场",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@rollup/rollup-win32-x64-msvc": "^4.60.4",
    "element-plus": "^2.9.1",
    "exceljs": "^4.4.0",
    "highlight.js": "^11.10.0",
    "pinia": "^2.3.0",
    "sql.js": "^1.10.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "unplugin-auto-import": "^0.19.0",
    "unplugin-vue-components": "^0.28.0",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue-tsc": "^2.2.0"
  }
}
